"use client";

/**
 * ─────────────────────────────────────────────────────────────────────────────
 *  SKIPCOMMAND — God-Mode Operations Dashboard
 *  Pretoria Skip Waste Rental · Dispatch / Revenue / Asset Intelligence
 *
 *  Stack: Next.js (App Router) · React · Tailwind CSS · Recharts · lucide-react
 *  Drop into: src/app/page.js
 * ─────────────────────────────────────────────────────────────────────────────
 */

