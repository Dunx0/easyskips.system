              {contracts.map((c) => (
                <div key={c.id} className={`rounded-xl px-3 py-2.5 ${t.chip}`}>
                  <p className="truncate text-xs font-semibold">{c.client}</p>
                  <p className={`mt-0.5 flex items-center gap-1 text-[11px] ${t.faint}`}>
                    <MapPin size={10} /> {c.site} · {c.skips}× {c.size}
                  </p>
                  <p className="mt-1 text-sm font-bold tabular-nums" style={{ color: ACCENT.mrr }}>
