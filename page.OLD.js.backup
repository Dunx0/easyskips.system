              </div>
              <Layers size={18} className={t.faint} />
            </div>

            {/* Overall donut */}
            <div className="relative mx-auto h-[170px] w-[170px]">
              <ResponsiveContainer width="100%" height="100%">
                <PieChart>
                  <defs>
                    <linearGradient id="gDonut" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stopColor="#fbbf24" />
                      <stop offset="100%" stopColor="#ea580c" />
                    </linearGradient>
                  </defs>
                  <Pie
                    data={donutData}
                    dataKey="value"
                    innerRadius={58}
                    outerRadius={78}
                    startAngle={90}
                    endAngle={-270}
                    paddingAngle={3}
                    stroke="none"
                  >
                    <Cell fill="url(#gDonut)" />
                    <Cell fill={dark ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.08)"} />
                  </Pie>
                </PieChart>
              </ResponsiveContainer>
              <div className="pointer-events-none absolute inset-0 grid place-items-center">
                <div className="text-center">
                  <p className="text-2xl font-extrabold tabular-nums tracking-tight">
                    {ops.totalDeployed}
                    <span className={`text-sm font-semibold ${t.faint}`}>/{ops.totalOwned}</span>
                  </p>
                  <p className={`text-[10px] font-semibold uppercase tracking-[0.16em] ${t.sub}`}>
                    Deployed
                  </p>
                </div>
              </div>
            </div>

            {/* Per-size dispatch board */}
            <div className={`mt-2 divide-y ${dark ? "divide-white/[0.06]" : "divide-zinc-100"}`}>
              {skip_fleet.map((f) => (
                <FleetRow key={f.size} t={t} fleet={f} dark={dark} />
              ))}
            </div>

            <div className={`mt-3 flex items-center gap-4 border-t pt-3 text-[11px] ${t.hairline} ${t.faint}`}>
              <span className="flex items-center gap-1.5">
                <CircleDot size={11} style={{ color: ACCENT.mrr }} /> On-site, earning
              </span>
              <span className="flex items-center gap-1.5">
                <CircleDot size={11} style={{ color: ACCENT.adhoc }} /> ≥90% class capacity
              </span>
            </div>
          </section>

          {/* BOTTOM ROW — OVERDUE COLLECTIONS */}
          <section className={`col-span-12 rounded-2xl p-5 ${t.panel}`}>
            <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 className="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em]">
                  Overdue Collections
                  <span className="rounded-full bg-rose-500/15 px-2 py-0.5 text-[11px] font-bold tabular-nums text-rose-400">
                    {ops.overdue.length}
                  </span>
                </h2>
                <p className={`text-xs ${t.sub}`}>
                  Skips beyond the {STANDARD_RENTAL_DAYS}-day standard hire — dispatch swap-out or collection now
                </p>
              </div>
              <span className={`text-xs tabular-nums ${t.faint}`}>
                Value at risk:{" "}
                <span className="font-semibold text-rose-400">
                  {zar.format(ops.overdue.reduce((s, i) => s + i.amount, 0))}
                </span>
              </span>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full min-w-[760px] text-sm">
                <thead>
                  <tr className={`border-b text-left text-[11px] font-semibold uppercase tracking-[0.12em] ${t.hairline} ${t.tableHead}`}>
                    <th className="pb-2.5 pr-4">Invoice</th>
                    <th className="pb-2.5 pr-4">Client</th>
                    <th className="pb-2.5 pr-4">On-site since</th>
                    <th className="pb-2.5 pr-4">Items</th>
                    <th className="pb-2.5 pr-4 text-right">Amount</th>
                    <th className="pb-2.5 pr-4 text-right">Days out</th>
                    <th className="pb-2.5 text-right">Status</th>
                  </tr>
                </thead>
                <tbody className={`divide-y ${dark ? "divide-white/[0.05]" : "divide-zinc-100"}`}>
                  {ops.overdue.map((row) => {
                    const severe = row.daysOut > STANDARD_RENTAL_DAYS + 5;
                    return (
                      <tr key={row.id} className={`transition-colors ${t.rowHover}`}>
                        <td className={`py-3 pr-4 font-mono text-xs ${t.sub}`}>{row.id}</td>
                        <td className="py-3 pr-4 font-medium">{row.client}</td>
                        <td className={`py-3 pr-4 tabular-nums ${t.sub}`}>{row.date}</td>
                        <td className={`py-3 pr-4 ${t.sub}`}>{row.items}</td>
                        <td className="py-3 pr-4 text-right font-semibold tabular-nums">
                          {zar.format(row.amount)}
                        </td>
                        <td
                          className={`py-3 pr-4 text-right font-bold tabular-nums ${
                            severe ? "text-rose-400" : "text-amber-400"
                          }`}
                        >
                          {row.daysOut}d
                        </td>
                        <td className="py-3 text-right">
                          <span
                            className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${
                              severe
                                ? "bg-rose-500/12 text-rose-400 ring-1 ring-rose-500/25"
                                : "bg-amber-500/12 text-amber-400 ring-1 ring-amber-500/25"
                            }`}
                          >
                            {severe ? <PhoneCall size={11} /> : <AlertTriangle size={11} />}
                            {severe ? "Escalate" : "Dispatch"}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                  {ops.overdue.length === 0 && (
                    <tr>
                      <td colSpan={7} className={`py-8 text-center text-sm ${t.faint}`}>
                        No skips beyond the standard hire window. Yard is clean.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        </div>

        <footer className={`mt-6 flex items-center justify-between text-[11px] ${t.faint}`}>
          <span>SkipCommand v1.0 · mock data layer — wire to Supabase when ready</span>
          <span className="tabular-nums">
            {skip_fleet.length} skip classes · {contracts.length} contracts · {invoices.length} invoices
          </span>
        </footer>
      </div>
    </main>
  );
}